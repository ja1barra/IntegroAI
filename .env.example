# ============================================================
# Server-side environment variables (set these in Vercel →
# Project → Settings → Environment Variables). They power the
# serverless functions in /api and are NEVER exposed to the browser.
# ============================================================

# ── LEGACY AI generation (/api/agent/generate, generate-sequence) ──
# Only used by tenants that have NOT been migrated to Revenue Manager
# (revenue_org_flags.legacy_outreach_enabled = true). Do not remove until every
# tenant is migrated (docs/revenue/migration-runbook.md). The Revenue features
# never read this key or any customer-supplied AI key.
# Fallback shared key used only for users who haven't connected their own
# AI provider from the "AI Provider" panel in Integrations (Anthropic,
# OpenAI, Google, or any OpenAI-compatible endpoint — see
# supabase/ai-provider-schema.sql). A user's own connected provider always
# takes priority, so Integro is never billed for their generation. Without
# either one configured, outreach falls back to deterministic mail-merge
# personalization and playbook generation is unavailable.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Gmail sending mailbox (/api/agent/send + OAuth callback) ──
# Google Cloud OAuth app credentials. Enable the Gmail API and add
# scope https://www.googleapis.com/auth/gmail.send. Authorized
# redirect URI: https://YOUR_DOMAIN/api/integrations/oauth-callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Other integration OAuth apps (optional) ──────────────────
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# OUTREACH_CLIENT_ID=
# OUTREACH_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# INTERCOM_CLIENT_ID=
# INTERCOM_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=


# ============================================================
# Revenue Manager (see docs/revenue/operations.md)
# Names only — never commit real values. None of these may be
# prefixed with VITE_ (that would ship them to the browser).
# ============================================================

# ── Supabase (server) ─────────────────────────────────────────
# Same project as VITE_SUPABASE_*. The URL / anon key are reused from the
# VITE_ variables when these are unset. The service-role key bypasses RLS:
# it is used ONLY server-side, always with an organization_id taken from a
# verified membership, and never sent to the browser.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── App ───────────────────────────────────────────────────────
# Public origin of the app (CORS allow-list + post-OAuth redirects).
APP_BASE_URL=https://YOUR_DOMAIN

# ── HubSpot OAuth app (customer connections) ──────────────────
# Create a *public app* in a HubSpot developer account. Redirect URL must be
# exactly HUBSPOT_REDIRECT_URI. Configure the same scopes as
# docs/revenue/hubspot-capabilities.md (read scopes required; write scopes optional).
HUBSPOT_CLIENT_ID=your-hubspot-app-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-app-client-secret
HUBSPOT_REDIRECT_URI=https://YOUR_DOMAIN/api/integrations/hubspot/callback
# Ask for the optional write scopes at connect time (tasks / deal updates)?
# Also implied per-organization by the hubspot_write_actions_enabled flag.
HUBSPOT_REQUEST_WRITE_SCOPES=false

# ── Credential encryption (OAuth tokens at rest, AES-256-GCM) ─
# Generate:  openssl rand -base64 32
# Rotation: set the NEW key + a new ID, move the old one to *_PREVIOUS as
# "<old-id>:<old-base64>", deploy, then run the rotate_credentials job.
CREDENTIALS_ENCRYPTION_KEY=base64-32-byte-key
CREDENTIALS_ENCRYPTION_KEY_ID=1
# CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=

# ── Managed OpenAI (one Integro-owned project key) ────────────
OPENAI_API_KEY=sk-your-openai-project-key
# A model you have verified is available AND good enough on the eval cases
# (docs/revenue/operations.md#model-selection). No default is assumed.
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=25000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=1800

# ── Worker / scheduler ────────────────────────────────────────
# Shared secret for POST /api/revenue/worker/tick (send as Bearer). Vercel Cron
# sends CRON_SECRET automatically; set both to the same value if you use Cron.
REVENUE_WORKER_SECRET=long-random-string
# Per-invocation time budget (ms). Keep below the function maxDuration in vercel.json.
REVENUE_WORKER_BUDGET_MS=40000

# Per-organization AI limits, retention and feature flags are NOT env vars:
# they live in Postgres (revenue_settings, revenue_org_flags) and are
# checked on the server for every request.
# Hours after which the scheduler enqueues an incremental sync for connected, confirmed
# organizations (rules depend on "today"). 0 disables scheduled syncs.
REVENUE_AUTO_SYNC_HOURS=6
